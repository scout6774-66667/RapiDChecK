# ==============================================================================
# RuralHealth AI (RapiDChecK) — Root Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' at the repository root or respective subdirectories.
# 2. Fill in the values appropriate for your environment.
# 3. NEVER commit production secrets or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Options: development, testing, production
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Leave empty for same-origin dev proxy or NGINX reverse proxy.
# Set only if frontend connects to an external backend host.
VITE_API_BASE_URL=

# Google Maps Platform (Optional: Live GPS nearby-doctor search, Places API)
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 3. Backend Database Configuration
# ------------------------------------------------------------------------------
# Development (SQLite local database file):
DATABASE_URL=sqlite:///./ruralhealth.db

# Production (PostgreSQL connection string — mandatory when ENVIRONMENT=production):
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
# DATABASE_URL=postgresql+psycopg2://rapidcheck_user:<STRONG_DB_PASSWORD>@postgres:5432/ruralhealth_prod

# Docker Compose PostgreSQL settings:
POSTGRES_DB=ruralhealth_prod
POSTGRES_USER=rapidcheck_user
POSTGRES_PASSWORD=replace-with-a-strong-random-password-for-production

# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# In production, JWT_SECRET_KEY must be a cryptographically secure random string (>= 32 chars).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-32-char-string-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=rapidcheck.internal
JWT_AUDIENCE=rapidcheck-clinical-workforce
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 5. Server-Side Cryptographic Attestation (HMAC-SHA256)
# ------------------------------------------------------------------------------
# In production, REVIEW_SECRET_KEY must be a cryptographically secure random string (>= 32 chars).
REVIEW_SECRET_KEY=replace-with-a-cryptographically-secure-random-32-char-string-in-production

# ------------------------------------------------------------------------------
# 6. CORS Domain Allowlist
# ------------------------------------------------------------------------------
# Comma-separated list of trusted frontend origins. Wildcards are strictly rejected in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 7. Local Offline AI Runtime (Ollama / Gemma 3 270M)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:270m
OLLAMA_TIMEOUT=45.0

# ------------------------------------------------------------------------------
# 8. Optional Cloud LLM Fallbacks (Leave empty if using local Ollama only)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 9. Snowflake Cloud Data Warehouse (Analytical Reporting & Verification)
# ------------------------------------------------------------------------------
# Backend-only analytical reporting. NEVER expose to frontend or client bundles.
# Account identifier format: <orgname>-<accountname> or <locator>.<region>
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RURALHEALTH_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=RURALHEALTH_APP_ROLE
SNOWFLAKE_LOGIN_TIMEOUT=15
SNOWFLAKE_NETWORK_TIMEOUT=15
