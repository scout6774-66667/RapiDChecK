# RuralHealth AI (RapiDChecK) — Environment Configuration Template
# Copy this file to .env and fill in your local values

# ── Google Maps Platform (Optional) ─────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ── Local Ollama AI Runtime ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:270m
OLLAMA_TIMEOUT=45.0

# ── Backend Database & Security ──────────────────────────────────────────────
DATABASE_URL=
JWT_SECRET_KEY=
REVIEW_SECRET_KEY=
