# ==============================================================================
# RuralHealth AI — Health-AI-main .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
.env.*.local
*.env

# Preserve safe templates containing placeholders only
!.env.example
!.env.sample
!.env.template
!**/.env.example
!**/.env.sample
!**/.env.template

*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
credentials*.json
service-account*.json
google-credentials*.json
*secret*.json

# ------------------------------------------------------------------------------
# 2. Local Databases & Dumps
# ------------------------------------------------------------------------------
*.db
*.db-*
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
ruralhealth.db
health_ai.db
*.dump
*.sql.gz
*.sql.bak
*.bak

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments, Caches & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
.venv/
**/.venv/
venv/
**/venv/
ENV/
env/
env.bak/
venv.bak/
build/
dist/
*.egg-info/
*.egg

# Testing & Caches
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
coverage/
**/coverage/
htmlcov/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 4. Frontend & Node.js
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/dist-ssr/
*.local

# ------------------------------------------------------------------------------
# 5. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
.cache/

# ------------------------------------------------------------------------------
# 6. IDE & OS
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
