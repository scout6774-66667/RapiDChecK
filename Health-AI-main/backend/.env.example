# Environment Mode (development, testing, production)
ENVIRONMENT=production

# Authoritative Production PostgreSQL Database URL (Mandatory in production)
DATABASE_URL=postgresql+psycopg2://rapidcheck_user:SuperSecurePassword123!@postgres:5432/ruralhealth_prod

# JWT Authentication Configuration
JWT_SECRET_KEY=generate_a_64_character_random_secret_for_production_jwt_signing
JWT_ISSUER=rapidcheck.internal
JWT_AUDIENCE=rapidcheck-clinical-workforce
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server-Side Cryptographic Attestation Key (HMAC-SHA256)
REVIEW_SECRET_KEY=generate_a_64_character_random_secret_for_attestation_signing

# CORS Domain Allowlists (Comma-separated)
CORS_ORIGINS=https://rapidcheck.health.gov.in,https://phc.rapidcheck.internal

# Server Logging & Metrics
LOG_LEVEL=INFO
ENABLE_METRICS=true
