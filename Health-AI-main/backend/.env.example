# ==============================================================================
# RuralHealth AI (RapiDChecK) — Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in this directory (Health-AI-main/backend/.env).
# 2. Fill in the values appropriate for your environment.
# 3. NEVER commit real passwords, keys, or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Options: development, testing, production
# - development: SQLite allowed, relaxed dev keys, local Ollama AI
# - production: PostgreSQL strictly enforced, 32+ char secrets mandatory, CORS restricted
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Development (SQLite local database file):
DATABASE_URL=sqlite:///./ruralhealth.db

# Production (PostgreSQL connection string — mandatory when ENVIRONMENT=production):
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
# DATABASE_URL=postgresql+psycopg2://rapidcheck_user:<STRONG_DB_PASSWORD>@postgres:5432/ruralhealth_prod

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# In production, JWT_SECRET_KEY must be a cryptographically secure random string (>= 32 chars).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-32-char-string-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=rapidcheck.internal
JWT_AUDIENCE=rapidcheck-clinical-workforce
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. Server-Side Cryptographic Attestation (HMAC-SHA256)
# ------------------------------------------------------------------------------
# In production, REVIEW_SECRET_KEY must be a cryptographically secure random string (>= 32 chars).
REVIEW_SECRET_KEY=replace-with-a-cryptographically-secure-random-32-char-string-in-production

# ------------------------------------------------------------------------------
# 5. CORS Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Wildcards ('*') are strictly rejected in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. Local Offline AI Runtime (Ollama / Gemma 3 270M)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:270m
OLLAMA_TIMEOUT=45.0

# ------------------------------------------------------------------------------
# 7. Optional Cloud LLM Fallbacks (Leave empty if using local Ollama only)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 8. Snowflake Cloud Data Warehouse (Analytical Reporting & Verification)
# ------------------------------------------------------------------------------
# Backend-only analytical reporting. NEVER expose to frontend or client bundles.
# Account identifier format: <orgname>-<accountname> or <locator>.<region>
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RURALHEALTH_DB
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=RURALHEALTH_APP_ROLE
SNOWFLAKE_LOGIN_TIMEOUT=15
SNOWFLAKE_NETWORK_TIMEOUT=15
