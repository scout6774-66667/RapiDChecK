# ==============================================================================
# RuralHealth AI (RapiDChecK) — Frontend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' or '.env.local' in this directory.
# 2. Vite exposes ONLY variables prefixed with 'VITE_' to the browser bundle.
# 3. NEVER add backend database URLs, passwords, or Snowflake credentials here.
# ==============================================================================

# API Base URL (leave empty for same-origin dev proxy or NGINX reverse proxy)
# Example for external API: VITE_API_BASE_URL=https://api.ruralhealth.example.com
VITE_API_BASE_URL=

# Google Maps Platform (Optional: Live GPS nearby-facility search, interactive map)
# Get a key at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=
