# ==============================================================================
# RuralHealth AI — Frontend .gitignore
# ==============================================================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & Build Output
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local

# Environment files & Secrets
.env
.env.*
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
.env.*.local
*.env
!.env.example
!.env.sample

# Secrets & Certificates
*.pem
*.key
*.p12
*.pfx
service-account*.json
credentials*.json
google-credentials*.json
*secret*.json

# Editor & OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
